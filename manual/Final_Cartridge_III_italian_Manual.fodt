     </table:table-cell>
     <table:table-cell table:style-name="Tabel1.B2" office:value-type="string">
      <text:p text:style-name="Monospace_20_klein">BASIC</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Tabel1.B2" office:value-type="string">
